# PFFT Multi-GPU Miner Config

# Ethereum RPC endpoint (use your own for stability)
ETH_RPC=https://ethereum-rpc.publicnode.com

# Per-GPU private keys (each GPU mines with its own wallet)
PRIVATE_KEY_0=your_private_key_for_gpu0
PRIVATE_KEY_1=your_private_key_for_gpu1
PRIVATE_KEY_2=your_private_key_for_gpu2
PRIVATE_KEY_3=your_private_key_for_gpu3

# Or use a single key for all GPUs (fallback if PRIVATE_KEY_N not set)
# PRIVATE_KEY=your_single_private_key_here

# Optional: specify which GPUs to use (comma-separated, default: all)
# GPUS=0,1,2,3

# GPU tuning
# GPU_BLOCKS=65535
# GPU_THREADS=256
# GPU_BATCHES_PER_STATUS=32

# Transaction settings
# GAS_LIMIT=200000
# PAUSE_BETWEEN_ROUNDS=3
